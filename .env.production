# --- 729 Agentic Newsroom: Global Production Environment ---

# 🌐 API & Infrastructure
PORT=8080

# 🔌 Cloud Database (PostgreSQL)
# REQUIRED: Paste your Railway/Render Postgres string here
DATABASE_URL=postgres://user:pass@host:port/dbname

# 🤖 Agentic AI (Gemini 1.5 Pro - Sovereign Edition)
# REQUIRED: Paste your Google AI API Key here
GEMINI_API_KEY=your_gemini_key_here

# ⚡ Performance & Caching (Optional)
REDIS_URL=redis://localhost:6379

# 🔐 Editorial Security
# These must match what you enter in the Dashboard login
ADMIN_USER=admin
ADMIN_PASS=headlines_secret_2026
JWT_SECRET=729_headlines_production_secret_2026

# 📡 Real-time Notifications (FCM)
FCM_SERVER_KEY=your_fcm_key_here
FCM_SERVICE_ACCOUNT_PATH=/app/configs/firebase-key.json

# 🕌 Utility Widgets (Malé)
PRAYER_METHOD=3 
LOCATION_NAME=Male, Maldives
LATITUDE=4.1755
LONGITUDE=73.5093
